# ─────────────────────────────────────────────
# Variables de entorno para PRUEBAS EN LOCAL
# En AWS Lambda estas variables se configuran en la consola, no con .env
# Copia este archivo a .env y rellena con tus valores reales
# NUNCA subas el .env a Git
# ─────────────────────────────────────────────

# Bucket S3 donde se guardan los backups
S3_BUCKET_NAME=tu-bucket-aqui
S3_PREFIX=lemlist-backups

# API keys de Lemlist (una por cliente)
API_KEY_CLIENTE1=xxxxxxxxxxxxx
API_KEY_CLIENTE2=xxxxxxxxxxxxx
API_KEY_CLIENTE3=xxxxxxxxxxxxx

# Credenciales AWS (solo necesarias para pruebas en local; en Lambda se usa el rol IAM)
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
AWS_REGION=eu-west-1
